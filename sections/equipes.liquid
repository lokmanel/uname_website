<section class="section-equipes">

  {%- if section.settings.title != blank -%}
    <h2 class="section-equipes__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  <div class="section-equipes__image-wrap" style="--img-size: {{ section.settings.image_size | default: 100 }}%;">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        style="object-position: {{ section.settings.image.presentation.focal_point | default: 'center' }};"
        alt="{{ section.settings.image.alt | default: section.settings.title }}"
        loading="lazy">
    {%- else -%}
      <div class="section-equipes__placeholder"></div>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "Les équipes",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Les équipes"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (format paysage recommandé)"
    },
    { "type": "header", "content": "Taille des images" },
    {
      "type": "range",
      "id": "image_size",
      "label": "Largeur des images (%)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Réduit les images en gardant leurs proportions, centrées. Sur mobile, elles restent en pleine largeur."
    }
  ],
  "presets": [
    { "name": "Les équipes" }
  ]
}
{% endschema %}
