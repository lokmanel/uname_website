<section class="section-project-duo">
  <div class="section-project-duo__grid" style="--img-size: {{ section.settings.image_size | default: 100 }}%;">
    <div class="section-project-duo__img">
      {%- if section.settings.image_1 != blank -%}
        <img
          src="{{ section.settings.image_1 | image_url: width: 1200 }}"
          style="object-position: {{ section.settings.image_1.presentation.focal_point | default: 'center' }};"
          alt="{{ section.settings.image_1.alt | default: '' }}"
          loading="lazy">
      {%- else -%}
        <div class="section-project-duo__placeholder"></div>
      {%- endif -%}
    </div>
    <div class="section-project-duo__img">
      {%- if section.settings.image_2 != blank -%}
        <img
          src="{{ section.settings.image_2 | image_url: width: 1200 }}"
          style="object-position: {{ section.settings.image_2.presentation.focal_point | default: 'center' }};"
          alt="{{ section.settings.image_2.alt | default: '' }}"
          loading="lazy">
      {%- else -%}
        <div class="section-project-duo__placeholder"></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Duo images",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image gauche"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image droite"
    },
    { "type": "header", "content": "Taille des images" },
    {
      "type": "range",
      "id": "image_size",
      "label": "Largeur des images (%)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Réduit les images en gardant leurs proportions, centrées. Sur mobile, elles restent en pleine largeur."
    }
  ],
  "presets": [
    { "name": "Duo images" }
  ]
}
{% endschema %}
